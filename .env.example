# --- Required -------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, RDS, or local). Server-only.
DATABASE_URL=postgres://user:password@host:5432/docksignal?sslmode=require

# CALL-E Developer API key from https://dashboard.heycall-e.com/account/api-keys
# Server-only. Never expose to the browser. Without it, calling is blocked.
CALLE_API_KEY=

# Public HTTPS origin of this deployment, no trailing slash. CALL-E posts
# terminal webhooks to ${PUBLIC_BASE_URL}/api/webhooks/calle
PUBLIC_BASE_URL=https://docksignal.example.com

# --- Optional -------------------------------------------------------------
# Shared secret for the reconciliation job. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>". Required in production.
CRON_SECRET=

# Connection pool size (default 5). Use 1 with the PGlite dev server from `npm run dev:db`.
# DATABASE_POOL_MAX=5

# CALL-E API base URL override (defaults to https://api.heycall-e.com).
# CALLE_BASE_URL=https://api.heycall-e.com

# Organisation name the AI assistant identifies itself as acting for.
DOCKSIGNAL_ORG_NAME=Northwind Freight Operations

# Pre-fill the intake form with numbers you own or are authorized to call
# (E.164). Keeps phone numbers off the screen recording and out of git.
DEMO_DRIVER_PHONE=
DEMO_DOCK_PHONE=
DEMO_DISPATCHER_PHONE=
DEMO_TIMEZONE=Asia/Singapore
